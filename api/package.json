{
  "name": "@starvis/api",
  "version": "1.0.0",
  "description": "Starvis - REST API for Star Citizen Database & Toolset",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env.dev server.ts",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "lint:ci": "biome check .",
    "openapi:lint": "swagger-cli validate openapi.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:sync": "tsx scripts/sync-openapi.mjs && biome check --write openapi.json",
    "openapi:check": "tsx scripts/sync-openapi.mjs --check"
  },
  "keywords": [
    "star-citizen",
    "api"
  ],
  "overrides": {
    "effect": ">=3.20.0",
    "path-to-regexp": "0.1.13"
  },
  "author": "ampynjord - Dawnstar",
  "license": "UNLICENSED",
  "dependencies": {
    "@starvis/db": "*",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-slow-down": "^3.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^7.17.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.21.0",
    "winston": "^3.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.0",
    "swagger-cli": "^4.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
